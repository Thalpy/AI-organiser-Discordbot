# Environment variables for the React frontend

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api
REACT_APP_WS_BASE_URL=ws://localhost:8000/ws

# Authentication
REACT_APP_AUTH_TOKEN_KEY=taskbot_auth_token
REACT_APP_SESSION_TIMEOUT=1440

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_COLLABORATION=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_WEBSOCKET=true

# Development
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info

# External Services
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_ANALYTICS_ID=

# UI Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_BRAND_NAME=TaskBot
REACT_APP_BRAND_COLOR=#5865F2